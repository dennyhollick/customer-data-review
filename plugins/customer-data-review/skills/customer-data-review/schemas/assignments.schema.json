{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Phase 3b per-agent assignment output",
  "description": "Mention-to-theme assignments for a single question batch.",
  "type": "object",
  "required": ["question_id", "assignments"],
  "additionalProperties": false,
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^Q\\d+$"
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["mention_id", "theme_id"],
        "additionalProperties": false,
        "properties": {
          "mention_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_]+_Q\\d+_\\d+$"
          },
          "theme_id": {
            "type": "string",
            "pattern": "^Q\\d+_T\\d+$"
          }
        }
      }
    }
  }
}
