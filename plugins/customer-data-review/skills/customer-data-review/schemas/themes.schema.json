{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "themes_{qid}.json",
  "description": "Theme definitions for a single question — output of Phase 3a.",
  "type": "object",
  "required": ["question_id", "themes"],
  "additionalProperties": false,
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^Q\\d+$"
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["theme_id", "label", "description", "type", "include", "exclude", "example_mention"],
        "additionalProperties": false,
        "properties": {
          "theme_id": {
            "type": "string",
            "pattern": "^Q\\d+_T\\d+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "enum": ["complaint", "praise", "feature_request", "competitive", "behavioral", "risk", "other"]
          },
          "include": {
            "type": "string",
            "minLength": 1
          },
          "exclude": {
            "type": "string"
          },
          "example_mention": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
